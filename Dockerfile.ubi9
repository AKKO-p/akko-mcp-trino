# The image on Red Hat Universal Base Image 9, for platforms that require it, and buildable with no
# network access: the rules of the Dockerfile, with RHEL's Python 3.12 and MIT Kerberos.
#
# Every Python package comes from wheelhouse/, which scripts/wheelhouse.sh writes from the locks
# (requirements/*.txt) on a machine with access to the package index; the build reads no index and
# installs no system package, so that it runs with --network=none:
#
#   docker build -f Dockerfile.ubi9 --network=none -t akko-mcp-trino:ubi9 .
#
# The base images are pinned by the digest of their multi-platform index. Without access to
# registry.access.redhat.com, pass the same images from an internal registry, by digest:
#
#   --build-arg BUILD_BASE=registry.example.internal/ubi9/python-312@sha256:<digest>
#   --build-arg BASE=registry.example.internal/ubi9/python-312-minimal@sha256:<digest>
#
# The build stage is the full Python image: it carries the compiler and the MIT Kerberos headers
# that gssapi and krb5 compile against. The final stage is the minimal Python image: the same
# Python and the same Kerberos libraries, without a compiler or a package manager beyond microdnf.
# ubi-minimal and ubi-micro have no Python 3.12, and installing it would need the network.
ARG BUILD_BASE=registry.access.redhat.com/ubi9/python-312:1-1795522683@sha256:5a0471c98fc10017d011c16b7615cd1d7f157d796f89eb4900ca0dc6c87384cf
ARG BASE=registry.access.redhat.com/ubi9/python-312-minimal:9.9-1795231781@sha256:3c3413652c3cf6aab00587926949ca8884f06b7d28dbbe69508e29aade34e2fe

FROM ${BUILD_BASE} AS build
USER 0
# No system package is installed: the base image brings the compiler and the Kerberos headers. Each
# one the build relies on is checked at its exact version, as the Dockerfile pins its apt packages,
# so that a new base image that moves one fails here (CONTRIBUTING.md says how to move them).
RUN rpm -q python3.12-3.12.16-2.el9_9 gcc-11.5.0-17.el9_9 glibc-devel-2.34-290.el9_9 \
      krb5-devel-1.21.1-10.el9_9.2
WORKDIR /src
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY akko_mcp_trino ./akko_mcp_trino
COPY providers/atlas ./providers/atlas
COPY requirements/build.txt requirements/kerberos.txt ./requirements/
# The build tools from their lock, wheels only, with their hashes, from the wheelhouse alone; the
# two packages build without isolation. Then the kerberos extra, as wheels: gssapi and krb5 from
# their sdists, compiled by the locked Cython against RHEL's MIT Kerberos, every other wheel the
# lock's own. The final stage reads both through mounts, so none of this stage enters the image.
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse \
    /usr/bin/python3.12 -m venv /opt/build \
 && /opt/build/bin/pip install --no-cache-dir --no-index --find-links /wheelhouse \
      --only-binary=:all: --require-hashes -r requirements/build.txt \
 && /opt/build/bin/python -m build --wheel --no-isolation \
 && /opt/build/bin/python -m build --wheel --no-isolation --outdir dist providers/atlas \
 && /opt/build/bin/pip wheel --no-cache-dir --no-index --find-links /wheelhouse --no-deps \
      --no-build-isolation --require-hashes -r requirements/kerberos.txt -w /src/kerberos

FROM ${BASE}
LABEL org.opencontainers.image.title="akko-mcp-trino" \
      org.opencontainers.image.description="Read-only MCP server for Trino" \
      org.opencontainers.image.source="https://github.com/AKKO-p/akko-mcp-trino" \
      org.opencontainers.image.licenses="Apache-2.0"
USER 0
# The Kerberos libraries gssapi and krb5 load (ATLAS_AUTH=kerberos) are in the base image, at the
# version the build stage compiled against: checked, as in the build stage.
RUN rpm -q python3.12-3.12.16-2.el9_9 glibc-2.34-290.el9_9 krb5-libs-1.21.1-10.el9_9.2 \
      keyutils-libs-1.6.3-1.el9 libcom_err-1.46.5-8.el9 openssl-libs-3.5.9-1.el9_9
# Every dependency from the lock, wheels only, with its hashes, from the wheelhouse alone; the core
# and the Atlas provider without dependencies; the kerberos extra from the wheels of the build
# stage only. pip check fails the build if the lock misses a dependency one of them declares. They
# go into the image's virtual environment (/opt/app-root, on PATH), installed by root; then
# nothing under it but the home directory belongs to the image's user or is writable by the group
# an arbitrary user runs in (0): the code cannot be changed, even on a writable root file system.
# The Atlas provider is inactive: nothing is loaded unless MCP_CONTEXT_PROVIDERS names it.
RUN --mount=type=bind,source=wheelhouse,target=/wheelhouse \
    --mount=type=bind,source=requirements/image.txt,target=/tmp/image.txt \
    --mount=type=bind,from=build,source=/src/dist,target=/tmp/dist \
    --mount=type=bind,from=build,source=/src/kerberos,target=/tmp/kerberos \
    pip install --no-cache-dir --no-index --find-links /wheelhouse \
      --only-binary=:all: --require-hashes -r /tmp/image.txt \
 && pip install --no-cache-dir --no-deps /tmp/dist/akko_mcp_trino-*.whl /tmp/dist/akko_mcp_trino_atlas-*.whl \
 && pip install --no-cache-dir --no-index --find-links /tmp/kerberos "akko-mcp-trino-atlas[kerberos]" \
 && pip check \
 && find /opt/app-root -path /opt/app-root/src -prune -o -exec chown -h 0:0 {} + \
 && find /opt/app-root -path /opt/app-root/src -prune -o ! -type l -exec chmod go-w {} +
# The image's user, numeric so that runAsNonRoot can check it. OpenShift runs an arbitrary UID in
# group 0 instead: HOME (/opt/app-root/src) is writable by that group, and the server writes only
# to /tmp, which the chart mounts (an emptyDir), so the root file system can be read-only. The
# working directory is /, which no one but root may write: python -c and python - put it on
# sys.path, and the base image's (HOME) would let that user plant a module there.
WORKDIR /
USER 1001
EXPOSE 3000 3001
HEALTHCHECK --interval=30s --timeout=3s CMD python -I -c "import urllib.request,os;urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"MCP_HEALTH_PORT\",\"3001\")}/health')"
CMD ["akko-mcp-trino"]
