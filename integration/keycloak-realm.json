{
  "realm": "integration",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "clients": [
    {
      "clientId": "mcp-host",
      "name": "an MCP host, acting for the user",
      "description": "Public client with the password grant, for the integration run only. Its tokens are issued for the MCP server (audience akko-mcp).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-akko-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "akko-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "akko-mcp",
      "name": "akko-mcp-trino",
      "description": "The MCP server. Confidential; may exchange a token issued for it for a token whose audience is trino (RFC 8693).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MCP_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trino",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "trino",
      "name": "Trino",
      "description": "The audience Trino accepts. No flow of its own.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MCP_CLIENT_SECRET}-trino",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "trino-cli",
      "name": "a Trino client, acting for the user",
      "description": "Public client with the password grant, for the integration run only. Its tokens are issued for Trino: the MCP server must refuse them.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trino",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Integration",
      "email": "alice@integration.example.com",
      "credentials": [
        {
          "type": "password",
          "value": "${INTEGRATION_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Integration",
      "email": "bob@integration.example.com",
      "credentials": [
        {
          "type": "password",
          "value": "${INTEGRATION_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
