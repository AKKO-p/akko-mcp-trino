# The sdist carries the package, its tests, its examples and the images its README shows.
prune dist
# Each context provider of providers/ ships in its own sdist.
prune providers
prune .venv
# What the tests read besides the package (they run from the sdist in CI): the texts they
# check, the locks, their scripts, the Dockerfile, the workflows, and the Atlas provider's
# metadata and READMEs.
include README.fr.md DOCKERHUB.md CONTRIBUTING.md CONTRIBUTING.fr.md
graft docs/guides
include requirements/*.in requirements/*.txt scripts/*.sh Dockerfile .github/workflows/*.yml
include providers/atlas/pyproject.toml providers/atlas/README.md providers/atlas/README.fr.md
include CHANGELOG.md MIGRATING.md pytest.ini
recursive-include tests *.py
graft examples
graft docs/images
global-exclude __pycache__ *.py[cod]
