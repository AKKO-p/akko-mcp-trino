# The sdist carries the package, its tests, its examples and the images its README shows.
prune dist
# Each context provider of providers/ ships in its own sdist.
prune providers
prune .venv
include image-requirements.txt
include CHANGELOG.md MIGRATING.md pytest.ini
recursive-include tests *.py
graft examples
graft docs/images
global-exclude __pycache__ *.py[cod]
