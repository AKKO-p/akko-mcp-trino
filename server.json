{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.akko-p/akko-mcp-trino",
  "title": "AKKO MCP server for Trino",
  "description": "Read-only MCP server for Trino: six tools, writes refused on the SQL tree, queries as one configured Trino identity or as the user by their own token, bounded rows and time, one audit line per call. Extensible by entry points.",
  "version": "0.5.1",
  "websiteUrl": "https://akko-ai.com/docs/akko-mcp-trino/",
  "repository": {
    "url": "https://github.com/AKKO-p/akko-mcp-trino",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "akko-mcp-trino",
      "version": "0.5.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TRINO_HOST",
          "description": "Trino coordinator host",
          "isRequired": true
        },
        {
          "name": "MCP_JWKS_URL",
          "description": "JWKS endpoint of the OIDC provider",
          "isRequired": true
        },
        {
          "name": "MCP_OIDC_ISSUER",
          "description": "Expected token issuer",
          "isRequired": true
        },
        {
          "name": "MCP_USER_TOKEN",
          "description": "The user's bearer token (stdio transport)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
